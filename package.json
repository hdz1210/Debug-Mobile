{
  "name": "app-network-debugger",
  "private": true,
  "version": "0.1.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hdz1210/Debug-Mobile.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm lint:frontend && pnpm lint:python && pnpm lint:rust",
    "lint:frontend": "eslint . --max-warnings=0",
    "lint:python": "node scripts/python-tool.mjs -m ruff check src-tauri/addons tests/python",
    "lint:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "test": "pnpm test:frontend && pnpm test:python && pnpm test:rust",
    "test:frontend": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:python": "node scripts/python-tool.mjs -m unittest discover -s tests/python -v",
    "test:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/phase1-smoke.ps1",
    "test:ui-smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/app-ui-smoke.ps1",
    "test:forced-exit": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/forced-exit-smoke.ps1",
    "release:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-release-sidecar.ps1",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.8",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@eslint/js": "^9.32.0",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.4",
    "vitest": "^3.2.4",
    "@tauri-apps/cli": "^2"
  }
}
